/* ParelVR SDK update pane (ParelUpdateWindow). Builds on Theme.uss: same tokens, square corners. */

.pu-hero {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
    background-color: var(--bk-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--bk-line);
}

.pu-logo {
    width: 38px;
    height: 38px;
    margin-right: 12px;
}

.pu-hero-text {
    flex-grow: 1;
}

.pu-product {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--bk-ink);
}

.pu-installed {
    font-size: 11px;
    color: var(--bk-ink-faint);
    margin-top: 2px;
}

.pu-body {
    flex-grow: 1;
    padding: 26px 22px 14px 22px;
}

.pu-state {
    flex-grow: 1;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s, 0.22s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.pu-state-enter {
    opacity: 0;
    translate: 0 8px;
}

.pu-status {
    align-items: center;
    margin-bottom: 16px;
}

.pu-glyph {
    width: 68px;
    height: 68px;
    margin-bottom: 14px;
}

.pu-glyph-accent { color: var(--bk-accent); }
.pu-glyph-good { color: var(--bk-good); }
.pu-glyph-bad { color: var(--bk-bad); }
.pu-glyph-faint { color: var(--bk-ink-faint); }

.pu-title {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--bk-ink);
}

.pu-text {
    font-size: 12px;
    color: var(--bk-ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
    max-width: 380px;
}

.pu-meta {
    font-size: 11px;
    color: var(--bk-ink-faint);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 12px;
}

.pu-hint {
    font-size: 11px;
    color: var(--bk-ink-faint);
    white-space: normal;
    margin-top: 2px;
}

/* Installed -> new version */

.pu-compare {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 2px;
}

.pu-chip {
    min-width: 128px;
    padding: 8px 14px;
    align-items: center;
    background-color: var(--bk-paper-2);
    border-width: 1px;
    border-color: var(--bk-line);
}

.pu-chip-new {
    background-color: var(--bk-accent-wash);
    border-color: var(--bk-accent);
}

.pu-chip-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--bk-ink-faint);
}

.pu-chip-new .pu-chip-label {
    color: var(--bk-accent-ink);
}

.pu-chip-value {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    margin-top: 2px;
}

.pu-chip-new .pu-chip-value {
    color: var(--bk-accent-ink);
}

.pu-compare-arrow {
    width: 30px;
    height: 18px;
    margin: 0 10px;
}

/* What's new */

.pu-notes {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 110px;
    max-height: 420px;
    margin-bottom: 10px;
}

.pu-notes-scroll {
    flex-grow: 1;
}

.pu-note-heading {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    margin-top: 6px;
    margin-bottom: 4px;
}

.pu-note-item {
    flex-direction: row;
    margin-bottom: 5px;
}

.pu-note-dot {
    width: 5px;
    height: 5px;
    margin: 6px 9px 0 2px;
    background-color: var(--bk-accent);
    flex-shrink: 0;
}

.pu-note-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--bk-ink-soft);
    font-size: 11px;
}

/* Updating */

.pu-progress {
    margin-top: 6px;
    margin-left: 30px;
    margin-right: 30px;
    height: 8px;
}

.pu-progress .bk-progress-fill {
    transition-property: width;
    transition-duration: 0.15s;
}

.pu-step {
    font-size: 11px;
    color: var(--bk-ink-faint);
    -unity-text-align: middle-center;
    margin-top: 8px;
}

/* Footer */

.pu-footer {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px;
    background-color: var(--bk-header);
    border-top-width: 1px;
    border-top-color: var(--bk-line);
}

.pu-source {
    flex-grow: 1;
    font-size: 11px;
    color: var(--bk-ink-faint);
    cursor: link;
}

.pu-source:hover {
    color: var(--bk-accent);
}

.pu-footer .bk-btn {
    margin-left: 6px;
    min-width: 92px;
    height: 26px;
}
