/* ParelVR SDK -- shared design tokens + component classes.
   A flat, neutral editor-tool look: charcoal surfaces, hairline borders, square-ish corners, a toolbar of
   tabs under the header and one restrained accent. It uses the Editor's own font so the Control Panel
   reads as part of Unity. Adapted per EditorGUIUtility.isProSkin through the .bk-dark / .bk-light root
   classes the Control Panel applies at load time.

   To re-brand, change --bk-accent, --bk-accent-hover, --bk-accent-ink and --bk-accent-wash below. */

.bk-light {
    --bk-paper: #C8C8C8;
    --bk-paper-2: #D6D6D6;
    --bk-paper-3: #BDBDBD;
    --bk-header: #B4B4B4;
    --bk-field: #EDEDED;
    --bk-ink: #101010;
    --bk-ink-soft: #2E2E2E;
    --bk-ink-faint: #555555;
    --bk-line: #A3A3A3;
    --bk-line-strong: #8C8C8C;
    --bk-accent: #7C5CD6;
    --bk-accent-hover: #6A4BC4;
    --bk-accent-ink: #3F2A85;
    --bk-accent-wash: #DCD3F3;
    --bk-on-accent: #FFFFFF;
    --bk-good: #1F7A4D;
    --bk-good-wash: #CFE6D8;
    --bk-warn: #8A5D06;
    --bk-warn-wash: #EFE0BD;
    --bk-bad: #B3261E;
    --bk-bad-wash: #F0CFCC;
}

.bk-dark {
    --bk-paper: #282828;
    --bk-paper-2: #313131;
    --bk-paper-3: #3A3A3A;
    --bk-header: #1C1C1C;
    --bk-field: #1F1F1F;
    --bk-ink: #E6E6E6;
    --bk-ink-soft: #BEBEBE;
    --bk-ink-faint: #8C8C8C;
    --bk-line: #1A1A1A;
    --bk-line-strong: #4A4A4A;
    --bk-accent: #B39DFF;
    --bk-accent-hover: #C8B8FF;
    --bk-accent-ink: #E3DAFF;
    --bk-accent-wash: #3B3550;
    --bk-on-accent: #1B1430;
    --bk-good: #5CC48E;
    --bk-good-wash: #1C3327;
    --bk-warn: #E3B04B;
    --bk-warn-wash: #3A3018;
    --bk-bad: #EE8A82;
    --bk-bad-wash: #3D2220;
}

.bk-root {
    flex-grow: 1;
    background-color: var(--bk-paper);
    font-size: 12px;
    color: var(--bk-ink);
}

/* ── Brand ─────────────────────────────────────────────────────── */

.bk-brandline {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.bk-brandline > Image {
    width: 20px;
    height: 20px;
    margin-right: 8px;
}

.bk-brandline > Label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.bk-heading {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    margin-bottom: 4px;
}

.bk-subheading {
    font-size: 12px;
    color: var(--bk-ink-faint);
    margin-bottom: 14px;
    white-space: normal;
}

/* A section header: a titled rule, the way the Builder groups its steps. */
.bk-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    background-color: var(--bk-paper-3);
    border-left-width: 3px;
    border-left-color: var(--bk-accent);
    border-radius: 0;
    padding: 6px 10px;
    margin-top: 14px;
    margin-bottom: 8px;
}

.bk-note {
    font-size: 11px;
    color: var(--bk-ink-faint);
    white-space: normal;
    margin-bottom: 8px;
}

.bk-text-good { color: var(--bk-good); }
.bk-text-bad { color: var(--bk-bad); }

/* ── Layout primitives ─────────────────────────────────────────── */

.bk-card {
    background-color: var(--bk-paper-2);
    border-width: 1px;
    border-color: var(--bk-line);
    border-radius: 0;
    padding: 10px;
    margin-bottom: 8px;
}

/* The title bar of a card: every section of a page is a card with one of these across its top. */
.bk-card-title,
.bk-card-titlebar {
    margin: -10px -10px 8px -10px;
    padding: 5px 10px;
    background-color: var(--bk-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--bk-line);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink);
}

.bk-card-titlebar {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 10px;
}

.bk-card-titlebar > .bk-label {
    margin-bottom: 0;
    color: var(--bk-ink);
}

.bk-card-titlebar .bk-btn {
    padding: 2px 10px;
    -unity-font-style: normal;
}

.bk-thumb-frame {
    background-color: var(--bk-field);
    border-width: 1px;
    border-color: var(--bk-line-strong);
    border-radius: 0;
    overflow: hidden;
}

/* A compact card for the rows of a list (a credit role, a product, a tier). */
.bk-panel {
    background-color: var(--bk-paper-2);
    border-width: 1px;
    border-color: var(--bk-line);
    border-radius: 0;
    padding: 10px 12px;
    margin-bottom: 8px;
}

.bk-panel .bk-panel {
    background-color: var(--bk-paper);
}

.bk-row {
    flex-direction: row;
    align-items: center;
}

.bk-spacer {
    flex-grow: 1;
}

.bk-divider {
    height: 1px;
    background-color: var(--bk-line-strong);
    margin-top: 12px;
    margin-bottom: 12px;
}

/* ── Property rows ─────────────────────────────────────────────── */
/* Every setting on every page is one of these: its name on the left, its value on the right. */

.bk-prop {
    flex-direction: row;
    align-items: flex-start;
    min-height: 24px;
    margin-bottom: 4px;
}

.bk-prop-label {
    width: 150px;
    flex-shrink: 0;
    padding-top: 5px;
    padding-left: 0;
    margin: 0;
    font-size: 12px;
    color: var(--bk-ink-soft);
    white-space: normal;
}

.bk-prop-value {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
}

.bk-prop-value > .unity-base-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
}

.bk-prop-value > .unity-toggle {
    margin-top: 3px;
}

/* ── Fields ────────────────────────────────────────────────────── */

.bk-field {
    margin-bottom: 10px;
}

.bk-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink-soft);
    margin-bottom: 4px;
}

.bk-input {
    background-color: var(--bk-field);
    border-width: 1px;
    border-color: var(--bk-line-strong);
    border-radius: 0;
    padding: 4px 6px;
    color: var(--bk-ink);
    font-size: 12px;
    min-height: 26px;
}

.bk-input:focus {
    border-color: var(--bk-accent);
}

.bk-input #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.bk-hint {
    font-size: 11px;
    color: var(--bk-ink-faint);
    margin-top: 4px;
    white-space: normal;
}

.bk-error-banner {
    background-color: var(--bk-bad-wash);
    color: var(--bk-bad);
    border-left-width: 3px;
    border-left-color: var(--bk-bad);
    border-radius: 0;
    padding: 8px 10px;
    font-size: 11px;
    margin-bottom: 12px;
    white-space: normal;
    display: none;
}

.bk-error-banner.bk-visible {
    display: flex;
}

/* ── Buttons ───────────────────────────────────────────────────── */

.bk-btn,
.bk-page .unity-button {
    background-color: var(--bk-paper-3);
    border-width: 1px;
    border-color: var(--bk-line);
    border-radius: 0;
    padding: 5px 12px;
    font-size: 12px;
    color: var(--bk-ink);
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.bk-btn {
    padding: 4px 12px;
}

.bk-btn:hover,
.bk-page .unity-button:hover {
    background-color: var(--bk-line-strong);
}

.bk-btn:disabled {
    opacity: 0.45;
}

.bk-btn-primary {
    -unity-font-style: bold;
    background-color: var(--bk-accent);
    border-color: var(--bk-accent);
    color: var(--bk-on-accent);
}

.bk-btn-primary:hover {
    background-color: var(--bk-accent-hover);
    border-color: var(--bk-accent-hover);
}

.bk-btn-warn {
    background-color: var(--bk-warn-wash);
    border-color: var(--bk-warn);
    color: var(--bk-warn);
}

.bk-btn-danger {
    background-color: var(--bk-bad-wash);
    border-color: var(--bk-bad);
    color: var(--bk-bad);
}

/* ── Status pills / badges ─────────────────────────────────────── */

.bk-pill {
    border-radius: 0;
    padding: 2px 8px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 0;
}

.bk-pill-accent { background-color: var(--bk-accent-wash); color: var(--bk-accent-ink); }
.bk-pill-good { background-color: var(--bk-good-wash); color: var(--bk-good); }
.bk-pill-warn { background-color: var(--bk-warn-wash); color: var(--bk-warn); }
.bk-pill-bad { background-color: var(--bk-bad-wash); color: var(--bk-bad); }
.bk-pill-neutral { background-color: var(--bk-paper-3); color: var(--bk-ink-soft); }

/* ── Top-level shell ───────────────────────────────────────────── */

.bk-topbar {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    background-color: var(--bk-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--bk-line);
    flex-shrink: 0;
}

/* The tabs are one toolbar across the window, each tab the same width. */
.bk-tabs {
    flex-direction: row;
    flex-shrink: 0;
    height: 26px;
    background-color: var(--bk-paper-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--bk-line);
}

.bk-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0 8px;
    border-right-width: 1px;
    border-right-color: var(--bk-line);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    color: var(--bk-ink-soft);
    -unity-text-align: middle-center;
    overflow: hidden;
}

.bk-tab:hover {
    background-color: var(--bk-paper-3);
    color: var(--bk-ink);
}

.bk-tab-active {
    background-color: var(--bk-paper);
    border-bottom-color: var(--bk-accent);
    color: var(--bk-ink);
    -unity-font-style: bold;
}

.bk-tab-active:hover {
    background-color: var(--bk-paper);
}

.bk-signed-in-label {
    font-size: 11px;
    color: var(--bk-ink-soft);
    margin-right: 10px;
}

/* ── World / avatar list rows ──────────────────────────────────── */

.bk-list-row {
    padding: 8px 10px;
    border-radius: 0;
    margin-bottom: 4px;
    background-color: var(--bk-paper-2);
    border-width: 1px;
    border-color: var(--bk-line);
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.bk-list-row:hover {
    background-color: var(--bk-paper-3);
}

.bk-list-row-active {
    background-color: var(--bk-accent-wash);
    border-color: var(--bk-accent);
}

/* Rows with a thumbnail get this scrim behind the text instead of the flat
   hover/active background-color above -- an image can be any brightness, so
   the name/status pill need a guaranteed-dark backdrop to stay legible. */
.bk-list-row-scrim {
    position: absolute;
    left: 0; right: 0; bottom: 0; top: 40%;
    background-color: rgba(0, 0, 0, 0.6);
}

.bk-list-row-info {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.bk-list-row-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 8px;
}

.bk-list-row-name-on-image {
    color: rgb(255, 255, 255);
}

.bk-progress-track {
    height: 6px;
    background-color: var(--bk-field);
    border-radius: 0;
    overflow: hidden;
    margin-top: 10px;
    margin-bottom: 4px;
}

.bk-progress-fill {
    height: 100%;
    background-color: var(--bk-accent);
    width: 0%;
}

.bk-version-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-top-width: 1px;
    border-top-color: var(--bk-line-strong);
}

.bk-version-num {
    font-size: 12px;
    color: var(--bk-ink);
    width: 40px;
}

.bk-version-meta {
    font-size: 11px;
    color: var(--bk-ink-faint);
    flex-grow: 1;
}

.bk-body {
    flex-grow: 1;
    padding: 8px;
}

/* The scrolling body of a page tab (Credits, Monetization). */
.bk-page {
    padding: 0 2px 16px 2px;
}

.bk-empty-state {
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    flex-grow: 1;
}

.bk-empty-state .bk-heading {
    -unity-text-align: middle-center;
}

.bk-empty-state .bk-subheading {
    -unity-text-align: middle-center;
}

/* ── Authentication page ───────────────────────────────────────── */

.bk-banner {
    align-items: center;
    padding: 18px 12px 16px 12px;
    margin-bottom: 8px;
    background-color: var(--bk-header);
    border-width: 1px;
    border-color: var(--bk-line);
    border-bottom-width: 2px;
    border-bottom-color: var(--bk-accent);
}

.bk-banner > Image {
    width: 56px;
    height: 56px;
    margin-bottom: 8px;
}

.bk-banner-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    -unity-text-align: middle-center;
}

.bk-banner-sub {
    font-size: 11px;
    color: var(--bk-ink-faint);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* ── Settings screen ───────────────────────────────────────────── */

.bk-settings-sidebar {
    width: 170px;
    flex-shrink: 0;
    align-self: stretch;
    padding: 8px 0;
    background-color: var(--bk-paper-2);
    border-width: 1px;
    border-color: var(--bk-line);
    border-radius: 0;
}

.bk-nav-item {
    padding: 7px 12px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    font-size: 12px;
    color: var(--bk-ink-faint);
}

.bk-nav-item:hover {
    background-color: var(--bk-paper-3);
    color: var(--bk-ink);
}

.bk-nav-item-active {
    background-color: var(--bk-paper-3);
    border-left-color: var(--bk-accent);
    color: var(--bk-ink);
    -unity-font-style: bold;
}

.bk-mode-option {
    background-color: var(--bk-paper-2);
    border-width: 1px;
    border-color: var(--bk-line);
    border-left-width: 3px;
    border-radius: 0;
    padding: 12px 14px;
    margin-bottom: 8px;
}

.bk-mode-option:hover {
    background-color: var(--bk-paper-3);
}

.bk-mode-option-active {
    border-left-color: var(--bk-accent);
    background-color: var(--bk-accent-wash);
}

.bk-mode-option-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--bk-ink);
    margin-bottom: 4px;
}

.bk-mode-option-desc {
    font-size: 11px;
    color: var(--bk-ink-faint);
    white-space: normal;
}

/* ── People: credits and user search ───────────────────────────── */

.bk-person {
    margin-top: 6px;
    padding: 6px 8px;
    background-color: var(--bk-paper);
    border-width: 1px;
    border-color: var(--bk-line);
    border-left-width: 3px;
    border-left-color: var(--bk-accent);
    border-radius: 0;
}

.bk-person-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-ink);
}

.bk-person-handle {
    font-size: 11px;
    color: var(--bk-ink-faint);
}

.bk-avatar {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 14px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: var(--bk-accent-wash);
    -unity-background-scale-mode: scale-and-crop;
}

.bk-avatar-initial {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--bk-accent-ink);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.bk-search-result {
    margin-top: 2px;
    padding: 5px 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: var(--bk-paper-2);
}

.bk-search-result:hover {
    background-color: var(--bk-accent-wash);
    border-color: var(--bk-accent);
}

.bk-search-result:disabled {
    opacity: 0.55;
}
