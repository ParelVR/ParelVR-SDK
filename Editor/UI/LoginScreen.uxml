<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="login-wrap">
    <ui:VisualElement name="login-card" class="bk-card">
      <ui:Label name="login-title" text="Sign In" class="bk-card-title" />

      <ui:VisualElement name="login-error" class="bk-error-banner">
        <ui:Label name="login-error-text" text="" />
      </ui:VisualElement>

      <ui:VisualElement name="login-form">
        <ui:VisualElement class="bk-prop">
          <ui:Label text="Username/Email" class="bk-prop-label" />
          <ui:VisualElement class="bk-prop-value">
            <ui:TextField name="login-identifier" class="bk-input" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="bk-prop">
          <ui:Label text="Password" class="bk-prop-label" />
          <ui:VisualElement class="bk-prop-value">
            <ui:TextField name="login-password" password="true" class="bk-input" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement name="totp-form" style="display: none;">
        <ui:VisualElement class="bk-prop">
          <ui:Label text="Authenticator Code" class="bk-prop-label" />
          <ui:VisualElement class="bk-prop-value">
            <ui:TextField name="login-totp" class="bk-input" />
            <ui:Button name="totp-cancel" text="Back" class="bk-btn" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="bk-row" style="margin-top: 8px;">
        <ui:Button name="login-submit" text="Sign In" class="bk-btn bk-btn-primary" style="flex-grow: 1; margin-left: 0;" />
        <ui:Button name="login-signup" text="Sign Up" class="bk-btn" style="flex-grow: 1; margin-right: 0;" />
      </ui:VisualElement>
      <ui:Label name="login-status" text="" class="bk-hint" />
    </ui:VisualElement>

    <ui:Label name="login-server" text="" class="bk-hint" style="-unity-text-align: middle-center;" />
  </ui:VisualElement>
</ui:UXML>
