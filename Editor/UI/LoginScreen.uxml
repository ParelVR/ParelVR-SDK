<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="login-wrap" class="bk-login-wrap">
    <ui:VisualElement name="login-card" class="bk-login-card">
      <ui:VisualElement class="bk-brandline">
        <ui:Image name="login-logo" />
        <ui:Label text="PARELVR SDK" />
      </ui:VisualElement>
      <ui:Label name="login-title" text="Sign in to ParelVR SDK" class="bk-login-title" />
      <ui:Label name="login-sub" text="Use your ParelVR account -- the same one you play with." class="bk-login-sub" />

      <ui:VisualElement name="login-error" class="bk-error-banner">
        <ui:Label name="login-error-text" text="" />
      </ui:VisualElement>

      <ui:VisualElement name="login-form">
        <ui:VisualElement class="bk-field">
          <ui:Label text="Username or email" class="bk-label" />
          <ui:TextField name="login-identifier" class="bk-input" />
        </ui:VisualElement>

        <ui:VisualElement class="bk-field">
          <ui:Label text="Password" class="bk-label" />
          <ui:TextField name="login-password" password="true" class="bk-input" />
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement name="totp-form" style="display: none;">
        <ui:VisualElement class="bk-field">
          <ui:Label text="Authenticator Code (6 digits)" class="bk-label" />
          <ui:TextField name="login-totp" class="bk-input" />
        </ui:VisualElement>
        <ui:Button name="totp-cancel" text="Cancel" class="bk-btn" style="width: 100%; margin-top: 6px;" />
      </ui:VisualElement>

      <ui:Button name="login-submit" text="Sign In" class="bk-btn bk-btn-primary" style="width: 100%; margin-top: 6px;" />
      <ui:Label name="login-status" text="" class="bk-hint" style="-unity-text-align: middle-center; margin-top: 10px;" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
